+/***********************************************************************
+ *           minus196_append_args
+ *
+ * -196: per-program extra command-line arguments. MINUS196_APPEND_ARGS holds entries
+ * separated by ';', each "program.exe|forbidden|arguments": when a process is created for
+ * program.exe and its command line does not contain the (possibly empty) forbidden text,
+ * the arguments are appended. Returns a new heap string, or NULL to leave things alone.
+ */
+static WCHAR *minus196_append_args( const WCHAR *app_name, const WCHAR *cmd_line )
+{
+    WCHAR rules[2048], *entry, *next, *forbidden, *args, *ret = NULL;
+    const WCHAR *file, *p;
+    DWORD len;
 
+    if (!app_name || !cmd_line) return NULL;
+    len = GetEnvironmentVariableW( L"MINUS196_APPEND_ARGS", rules, ARRAY_SIZE(rules) );
+    if (!len || len >= ARRAY_SIZE(rules)) return NULL;
+
+    for (file = p = app_name; *p; p++) if (*p == '\\' || *p == '/') file = p + 1;
+
+    for (entry = rules; entry && *entry; entry = next)
+    {
+        if ((next = wcschr( entry, ';' ))) *next++ = 0;
+        if (!(forbidden = wcschr( entry, '|' ))) continue;
+        *forbidden++ = 0;
+        if (!(args = wcschr( forbidden, '|' ))) continue;
+        *args++ = 0;
+        if (wcsicmp( entry, file ) || !*args) continue;
+        if (*forbidden && wcsstr( cmd_line, forbidden )) continue;
+        if (wcsstr( cmd_line, args )) continue;  /* already there */
+        len = lstrlenW( cmd_line ) + lstrlenW( args ) + 2;
+        if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return NULL;
+        swprintf( ret, len, L"%s %s", cmd_line, args );
+        break;
+    }
+    return ret;
+}
